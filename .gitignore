# https://github.com/github/gitignore/tree/main/community/Golang/Go.AllowList.gitignore
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore

# Ignore everything
*

# But not these files...
!/.gitignore

!/.editorconfig

!/Dockerfile
!/docker-bake.hcl
!/.dockerignore

!*.go
!go.sum
!go.mod

!*.tmpl
!*.yaml
!*.yml

!README.md
!LICENSE

!Makefile

# ...even if they are in subdirectories
!*/
